# =============================================================================
# Root-level .env.example
# =============================================================================
# Copy this file to `.env` at the repo root, replace the placeholder values,
# and `chmod 600 .env`. The actual `.env` is git-ignored and MUST NOT be
# committed.
#
# These variables are consumed by:
#   - docker-compose.openclaw.yml  (via `env_file: ./backend/.env`)
#   - backend/config.py            (via python-dotenv load_dotenv)
#
# NOTE: backend/.env is the canonical secrets file the FastAPI process reads.
# This root .env mirrors a subset for `docker compose` substitution. If you
# only run the gateway via compose, populate backend/.env (compose's env_file
# points there) and you are done. The root .env is optional.
# =============================================================================

# -----------------------------------------------------------------------------
# OpenClaw Gateway bearer
# -----------------------------------------------------------------------------
# 32-byte hex secret. Generate with:
#   openssl rand -hex 32
# The FastAPI forwarder presents this as Authorization: Bearer <value> on
# POST /v1/chat/completions to the gateway.
OPENCLAW_GATEWAY_TOKEN=replace-me-with-strong-secret

# -----------------------------------------------------------------------------
# Llama Stack (LLM provider) API key
# -----------------------------------------------------------------------------
# Read by the gateway when it dials the OCI-hosted Llama Stack endpoint
# referenced from .openclaw/openclaw.json (provider id "llamastack").
LLAMA_STACK_API_KEY=replace-me

# -----------------------------------------------------------------------------
# Agent-Tools bearer (FastAPI <- OpenClaw plugin auth)
# -----------------------------------------------------------------------------
# 32-byte hex secret, distinct from OPENCLAW_GATEWAY_TOKEN. Generate with:
#   openssl rand -hex 32
# Used by the TS plugins inside the container to authenticate POSTs back to
# http://host.docker.internal:8000/api/agent-tools/* . The same value is read
# by backend/routers/agent_tools.py on the FastAPI side. If unset, the
# agent-tools router fails closed with HTTP 503.
AGENT_TOOLS_BEARER=replace-me-with-another-strong-secret

# -----------------------------------------------------------------------------
# Note: the legacy `OPENCLAW_ENABLED` rollback gate was removed in ARCH 15
# (final agent-unification cleanup). All chat / QA / synthesis traffic now
# flows through the OpenClaw gateway unconditionally; there is no in-process
# ToolLoopDriver fallback to gate. If you have it set in a local .env, it is
# safely ignored by Settings (extra="ignore") but should be deleted.
# -----------------------------------------------------------------------------
