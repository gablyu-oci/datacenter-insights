{
  "models": {
    "providers": {
      "llamastack": {
        "baseUrl": "https://llama-stack.ai-apps-ord.oci-incubations.com/v1",
        "apiKey": "${LLAMA_STACK_API_KEY}",
        "api": "openai-completions",
        "request": {
          "allowPrivateNetwork": true
        },
        "timeoutSeconds": 300,
        "models": [
          {
            "id": "oci/openai.gpt-5.4",
            "name": "OCI GPT-5.4 via Llama Stack",
            "reasoning": false,
            "input": [
              "text"
            ],
            "contextWindow": 128000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "llamastack/oci/openai.gpt-5.4"
      }
    }
  },
  "gateway": {
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:18789",
        "http://127.0.0.1:18789"
      ]
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "oci-insights": {
        "url": "http://host.docker.internal:8002/mcp",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Bearer ${AGENT_TOOLS_BEARER}"
        }
      }
    }
  },
  "meta": {
    "lastTouchedVersion": "2026.5.6",
    "lastTouchedAt": "2026-05-06T12:00:00.000Z"
  }
}
