# Database (asyncpg driver for SQLModel async sessions)
DATABASE_URL=postgresql+asyncpg://sit_app:changeme@localhost:5432/strategic_insights

# CORS allowed origins (JSON array)
ALLOWED_ORIGINS=["http://localhost:5173"]

# Mock data gate: set to 1 to enable mock data endpoints
MOCK_DATA=0

# SEC EDGAR API user agent (required by SEC fair-access policy)
EDGAR_USER_AGENT=Datacenter Intelligence Platform research@oracle.com

# Llama Stack LLM endpoint (OCI-hosted, OpenAI-compatible)
LLAMA_STACK_URL=https://llama-stack.ai-apps-ord.oci-incubations.com
