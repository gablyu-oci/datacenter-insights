# Database (asyncpg driver for SQLModel async sessions)
DATABASE_URL=postgresql+asyncpg://sit_app:changeme@localhost:5432/strategic_insights

# CORS allowed origins (JSON array)
ALLOWED_ORIGINS=["http://localhost:5173"]

# Mock data gate: set to 1 to enable mock data endpoints
MOCK_DATA=0

# Deployment environment. Read by backend/config.py (pydantic-settings).
# The `current_user_email` FastAPI dependency permits the `dev@local` fallback
# (when X-Forwarded-Email is missing) only when this is != "production".
# - Local dev: leave unset or set to "development" (the default).
# - Production host (datacenter.oci-incubations.com): MUST set ENVIRONMENT=production
#   so requests without the oauth2-proxy identity header are rejected.
ENVIRONMENT=development

# SEC EDGAR API user agent (required by SEC fair-access policy)
EDGAR_USER_AGENT=Datacenter Intelligence Platform research@oracle.com

# Llama Stack LLM endpoint (OCI-hosted, OpenAI-compatible)
LLAMA_STACK_URL=https://llama-stack.ai-apps-ord.oci-incubations.com

# Web search for V2 AI Insights citations (free tier: 2k req/month)
# Sign up at https://brave.com/search/api/ — drop the secret in backend/.env
BRAVE_SEARCH_API_KEY=

# ----------------------------------------------------------------------
# OpenClaw gateway (PRD 11a / ARCH 11b / ADDENDUM 11c / ARCH 15)
# ----------------------------------------------------------------------
# All chat / QA / synthesis traffic flows through the OpenClaw gateway.
# The legacy ToolLoopDriver lane was removed in Phase 5-followup so
# there is no `OPENCLAW_ENABLED` flag.

# OpenClaw gateway URL the FastAPI forwarder dials.
# Per ADDENDUM 11c §A: container's port 18789 is bound to host port 7474.
OPENCLAW_GATEWAY_URL=http://localhost:7474

# Bearer the FastAPI forwarder presents on POST /v1/chat/completions.
# Generate one 32-byte hex string per environment; do NOT commit.
OPENCLAW_GATEWAY_TOKEN=

# Bearer the OpenClaw plugins present on calls back into FastAPI
# (/api/agent-tools/*). Same value lives inside the OpenClaw container.
AGENT_TOOLS_BEARER=

# API key for the OCI Llama Stack provider that OpenClaw points at.
# Read by openclaw.json via ${LLAMA_STACK_API_KEY} substitution.
LLAMA_STACK_API_KEY=

# ----------------------------------------------------------------------
# OCI Object Storage mirror for daily Aterio snapshots
# ----------------------------------------------------------------------
# Read by backend/pipeline/aterio_oci_mirror.py. Bucket `aterio-archive`
# in tenancy namespace `iduyx1qnmway` mirrors
# backend/data/aterio_archive/<date>/{inventory,events}/.
#
# Set OCI_ARCHIVE_ENABLED=0 (or leave unset) to no-op the mirror. CI
# MUST keep this disabled — tests rely on mocks; the SDK is imported
# lazily inside the disabled branch.
#
# Auth uses ~/.oci/config. This currently works for the bare-metal /
# systemd deploy on the production VM. TODO: container deploys would
# need a read-only mount of the host's ~/.oci/ into the backend image
# (no Dockerfile exists today, so deferred).
# OCI_ARCHIVE_ENABLED=0
# OCI_ARCHIVE_NAMESPACE=iduyx1qnmway
# OCI_ARCHIVE_BUCKET=aterio-archive
# OCI_CONFIG_FILE=~/.oci/config
# OCI_CONFIG_PROFILE=DEFAULT
