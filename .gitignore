# Environment files containing secrets
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env.local
frontend/.env.*.local
!frontend/.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Node / React
node_modules/
frontend/dist/
frontend/.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code per-project local config (contains personal allow rules)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Run logs (dev-team, backend, frontend)
logs/

# OS
.DS_Store
Thumbs.db
cdx2.json

# Root-level secrets (compose interpolation file). The repo's canonical
# secrets file is backend/.env (already git-ignored above). The root .env
# is an optional mirror; if it exists it MUST NOT be committed.
/.env
!/.env.example

# OpenClaw runtime state
# ---------------------------------------------------------------------------
# The /.openclaw tree holds container-mounted state. Most of it is
# runtime-mutable (sessions, JSONL transcripts, SQLite session-stores, dynamic
# agent dirs) and MUST NOT be committed. A handful of declarative files DO
# need to be in git so first-boot is reproducible:
#   - /.openclaw/openclaw.json                     (provider + gateway config)
#   - /.openclaw/workspace/SOUL.md                 (persona)
#   - /.openclaw/extensions/**/*                   (TS plugin source)
#   - /.openclaw/.gitkeep                          (anchor for empty repo)
# Everything else under /.openclaw is ignored.
/.openclaw/agents/
/.openclaw/sessions/
/.openclaw/**/sessions/
/.openclaw/**/*.jsonl
/.openclaw/**/*.sqlite
/.openclaw/**/*.sqlite-*
/.openclaw/**/*.db
/.openclaw/**/*.db-*
/.openclaw/cache/
/.openclaw/logs/
/.openclaw/tmp/
/.openclaw/workspace/sessions/
/.openclaw/workspace/cache/
/.openclaw/workspace/.openclaw/
# Also ignore everything the gateway auto-generates on first boot that
# might leak secrets (the auto-stub openclaw.json contains a generated
# bearer token; the .bak / .last-good are copies of same):
/.openclaw/openclaw.json.bak
/.openclaw/openclaw.json.bak.*
/.openclaw/openclaw.json.last-good
/.openclaw/openclaw.json.*.tmp
/.openclaw/update-check.json
/.openclaw/identity/
/.openclaw/canvas/
# Additional runtime-mutable state (devices/memory DBs/exec approvals/
# auto-installed plugin-skills); persona-level files in workspace/
# (SOUL/AGENTS/MEMORY/IDENTITY/USER/TOOLS/HEARTBEAT) are still tracked.
/.openclaw/devices/
/.openclaw/exec-approvals.json
/.openclaw/memory/
/.openclaw/plugin-skills/
# Workspace dream-cycle outputs and daily notes are runtime drift.
# SCHEMA.md and QUERIES.md are durable reference docs the agent reads
# at session boot — they ARE tracked; only DREAMS.md and the per-day
# memory notes are drift.
/.openclaw/workspace/DREAMS.md
/.openclaw/workspace/memory/
# Explicit allows for the declarative files we DO want in git:
!/.openclaw/.gitkeep
!/.openclaw/workspace/
!/.openclaw/workspace/SOUL.md
!/.openclaw/extensions/
!/.openclaw/extensions/**/*
# NOTE: /.openclaw/openclaw.json is intentionally NOT explicitly
# allow-listed. The backend agent's deliverable is a committed JSON5
# config at that path WITH NO BAKED-IN SECRETS (it references env vars
# via ${OPENCLAW_GATEWAY_TOKEN}, ${LLAMA_STACK_API_KEY}). When that file
# is committed, the operator must `git add -f .openclaw/openclaw.json`
# the FIRST time and verify by-eye there is no literal secret in it.

# Adapter disk caches: regeneratable from external APIs, not for git.
backend/data/cache/submissions_*.json
backend/data/cache/filing_*.json
backend/data/cache/earnings_av_*.json
backend/data/cache/real_quarterly_*.json
